---
import { Image } from 'astro:assets'
import logo from '../../assets/QPToZJ69.jpeg'
import { Icon } from 'astro-icon/components'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
console.log('BASE: ', base)
---

<nav>

  <!--  barra de bavegacion para desktop   -->
  <div class="hidden lg:flex lg:p-7 lg:justify-center lg:items-center lg:gap-20">
    <a href={`${base}/`}><Image src={logo} alt="logo de la pagina" width={50} class="" /></a>
      
      <div>
        <ul class="flex gap-8">
          <li class="relative group">
            <a href={`${base}/`} class="hover:text-cyan-400 flex gap-1 items-center">
              Inicio
            </a>
          </li>

          <!-- Marco Teorico -->
          
          <li class="relative group">
            <a href={`${base}/marcot`} class="hover:text-cyan-400 flex gap-1 items-center">
              Marco Teorico

              <svg 
                class="w-4 h-4 transition-transform duration-1000 group-hover:rotate-180 mt-1/2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                >
                <path 
                  stroke-linecap="round"
                  stroke-lonejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </a>
             <!-- Submenu -->
             <ul class="absolute left-0 top-full mt-2 w-64 bg-[#1e538a] text-white rounded-lg shadow-xl
                        opacity-0 invisible translate-y-4 scale-95 transition-all duration-300 group-hover:opacity-100
                        group-hover:visible group-hover:scale-100 group-hover:translate-y-0 z-11">
              <li>
                <a href={`${base}/marcot#intro`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Introduccion
                  </span>
                  
                </a>
              </li>
              <li>
                <a href={`${base}/marcot#ant`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Antecedentes
                  </span>
                </a>
              </li>
              <li>
                <a href={`${base}/marcot#plan`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Planteamiento del Problema
                  </span>
                </a>
              </li>
              <li>
                <a href={`${base}/marcot#arbol`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Arbol del Problema
                  </span>
                </a>
              </li>
              <li>
                <a href={`${base}/marcot#form`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Formulacion del Problema
                  </span>
                  
                </a>
              </li>
              <li>
                <a href={`${base}/marcot#prop`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Proposito de Estudio
                  </span>
                </a>
              </li>
              <li>
                <a href={`${base}/marcot#meto`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Metodologia
                  </span>
                </a>
              </li>
              <li>
                <a href={`${base}/marcot#act`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Planificacion de Actividades
                  </span>
                </a>
              </li>
            </ul>
          </li>
          
          <!-- Analisis Estructurado -->

          <li class="relative group">
            <a href={`${base}/analisis_es`} class="hover:text-cyan-400 flex gap-1 items-center">
              Analisis Estructurado

              <svg 
                class="w-4 h-4 transition-transform duration-1000 group-hover:rotate-180 mt-1/2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                >
                <path 
                  stroke-linecap="round"
                  stroke-lonejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </a>

            <ul class="absolute left-0 top-full mt-2 w-64 bg-[#1e538a] text-white rounded-lg shadow-xl
                          opacity-0 invisible translate-y-3 transition-all duration-300 group-hover:opacity-100
                          group-hover:visible group-hover:translate-y-0 z-11">
              <li class="group/submenu">
                <a href="#" class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Modelo Ambiental
                  </span>
                </a>
                 <ul
                    class="
                      absolute

                      left-full
                      top-0

                      w-64

                      bg-[#1e538a]
                      text-white

                      rounded-lg
                      shadow-xl

                      opacity-0
                      invisible

                      translate-x-4
                      scale-95

                      transition-all
                      duration-300

                      group-hover/submenu:opacity-100
                      group-hover/submenu:visible
                      group-hover/submenu:translate-x-0
                      group-hover/submenu:scale-100

                      z-50
                    "
                  >
                    <li>
                      <a href={`${base}/analisis_es#declaracion`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                        <Icon name="squares" title='squares' size={30} 
                              class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                        <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                          Declaracion de Proposito
                        </span>
                      </a>
                    </li>
                    <li>
                      <a href={`${base}/analisis_es#diagrama`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                        <Icon name="squares" title='squares' size={30} 
                              class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                        <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                          Diagrama de Contexto
                        </span>
                      </a>
                    </li>
                    <li>
                      <a href={`${base}/analisis_es#lista`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                        <Icon name="squares" title='squares' size={30} 
                              class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                        <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                          Lista de Acontecimientos
                        </span>
                      </a>
                    </li>
                 </ul>              
              </li>
              <li class="group/submenu">
                <a href={`${base}/analisis_es#`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                  <Icon name="squares" title='squares' size={30} 
                        class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                  <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                    Modelo de Comportamiento
                  </span>
                </a>
                 <ul
                    class="
                      absolute

                      left-full
                      top-0

                      w-64

                      bg-[#1e538a]
                      text-white

                      rounded-lg
                      shadow-xl

                      opacity-0
                      invisible

                      translate-x-4
                      scale-95

                      transition-all
                      duration-300

                      group-hover/submenu:opacity-100
                      group-hover/submenu:visible
                      group-hover/submenu:translate-x-0
                      group-hover/submenu:scale-100

                      z-50
                    "
                  >
                    <li>
                      <a href={`${base}/analisis_es#dfd`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                        <Icon name="squares" title='squares' size={30} 
                              class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                        <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                          DFD por Niveles
                        </span>
                      </a>
                    </li>
                    <li>
                      <a href={`${base}/analisis_es#der`} class="group/menu flex items-center p-3 hover:bg-gray-800 hover:text-cyan-400">
                        <Icon name="squares" title='squares' size={30} 
                              class="opacity-0 -translate-x-8 transition-all duration-300 group-hover/menu:opacity-100 group-hover/menu:translate-x-0"/> 
                        <span class="inline-block transition-transform duration-300 group-hover/menu:translate-x-3">
                          DER
                        </span>
                      </a>
                    </li>
                 </ul>              
              </li>
            </ul>
          </li>


          <li class="relative group">
            <a href={`${base}/ood`} class="hover:text-cyan-400 flex gap-1 items-center">
              Orientado a Objetos 
            </a>
          </li>
          <li class="relative group">
            <a href={`${base}/videos`} class="hover:text-cyan-400 flex gap-1 items-center">
              Videos
            </a>
          </li>
          <li class="relative group">
            <a href={`${base}/contactos`} class="hover:text-cyan-400 flex gap-1 items-center">
              Contactos            
            </a>
          </li>
        </ul>
      </div>

      <a>
        <Icon 
          name="search"
          title='search-icon'
          size={30}
          class="hover:text-cyan-400"
        />
      </a>
  </div>
  <div class="lg:hidden flex justify-between items-center">
    <Image
    src={logo}
    alt="logo"
    width={45}
    class="m-6"
    />

    <button id="menu-btn">
      <svg
        class="w-8 h-8 m-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>

    <div id="overlay" class="fixed inset-0 bg-[#1e538a] opacity-0 invisible transition-all duration-300 z-40">
    </div>
    <div
        id="mobile-menu"
        class="
          fixed
          top-0
          left-0

          h-screen
          w-80

          bg-[#1e538a]

          -translate-x-full
          transition-transform
          duration-300

          z-50
        "
      >

        <div class="p-4 border-b border-white/20">

          <Image
            src={logo}
            alt="logo"
            width={50}
          />

        </div>

        <ul class="py-2">

          <li>
            <a
              href={`${base}/`}
              class="block p-4 hover:bg-blue-700"
            >
              Inicio
            </a>
          </li>

          <!-- Marco Teórico -->

          <li>

            <details>

              <summary
                class="
                  cursor-pointer
                  p-4
                  hover:bg-blue-700
                "
              >
                Marco Teórico
              </summary>

              <ul class="pl-6">

                <li>
                  <a href={`${base}/marcot#intro`} class="block p-3">
                    Introducción
                  </a>
                </li>

                <li>
                  <a href={`${base}/marcot#ant`} class="block p-3">
                    Antecedentes
                  </a>
                </li>
                
                <li>
                  <a href={`${base}/marcot#plan`} class="block p-3">
                    Planificacion del Problema
                  </a>
                </li>

                <li>
                  <a href={`${base}/marcot#arbol`} class="block p-3">
                    Arbol de Problemas
                  </a>
                </li>

                <li>
                  <a href={`${base}/marcot#form`} class="block p-3">
                    Formulacion del Problema
                  </a>
                </li>
                
                <li>
                  <a href={`${base}/marcot#prop`} class="block p-3">
                    Proposito del Estudio
                  </a>
                </li>

                <li>
                  <a href={`${base}/marcot#meto`} class="block p-3">
                    Metodología
                  </a>
                </li>
                
                <li>
                  <a href={`${base}/marcot#act`} class="block p-3">
                    Planificacion de Actividades
                  </a>
                </li>

              </ul>

            </details>

          </li>

          <!-- Analisis Estructurado -->

          <li>

            <details>

              <summary
                class="
                  cursor-pointer
                  p-4
                  hover:bg-blue-700
                "
              >
                Análisis Estructurado
              </summary>

              <ul class="pl-6">

                <!-- Modelo Ambiental -->

                <li>

                  <details>

                    <summary
                      class="
                        cursor-pointer
                        p-3
                        hover:bg-blue-700
                      "
                    >
                      Modelo Ambiental
                    </summary>

                    <ul class="pl-6">

                      <li>
                        <a href={`${base}/analisis_es#declaracion`} class="block p-3">
                          Declaración de Propósito
                        </a>
                      </li>

                      <li>
                        <a href={`${base}/analisis_es#diagrama`} class="block p-3">
                          Diagrama de Contexto
                        </a>
                      </li>

                      <li>
                        <a href={`${base}/analisis_es#lista`} class="block p-3">
                          Lista de Acontecimientos
                        </a>
                      </li>

                    </ul>

                  </details>

                </li>

                <!-- Modelo de Comportamiento -->

                <li>

                  <details>

                    <summary
                      class="
                        cursor-pointer
                        p-3
                        hover:bg-blue-700
                      "
                    >
                      Modelo de Comportamiento
                    </summary>

                    <ul class="pl-6">

                      <li>
                        <a href={`${base}/analsis_es#dfd`} class="block p-3">
                          DFD por Niveles
                        </a>
                      </li>

                      <li>
                        <a href={`${base}/analisis_es#der`} class="block p-3">
                          DER
                        </a>
                      </li>

                    </ul>

                  </details>

                </li>
                

              </ul>

            </details>

          </li>
          <li>
            <summary>
              <a href={`${base}/videos`} class="p-3 block hover:bg-blue-700">Videos</a>
            </summary>
          </li>

          <li>
            <a href={`${base}/contactos`} class="p-3 block hover:bg-blue-700">Contactos</a>
          </li>

        </ul>

      </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('overlay');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('-translate-x-full');

    overlay?.classList.toggle('opacity-100');
    overlay?.classList.toggle('visible');

  });

  overlay?.addEventListener('click', () => {
    menu?.classList.add('-translate-x-full');

    overlay?.classList.remove('opacity-100');
    overlay?.classList.remove('visible');
  });
</script>
