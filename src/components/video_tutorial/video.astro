---
import NAV from '../tools/navegationBar.astro'
import FOOTER from '../tools/footer.astro'
---

<header class="bg-[#1e538a] lg:h-27 md:15 sm:15 mb-5">
  <NAV />
</header>

<section>
  <div class="flex flex-col items-center text-black mt-10 mb-10">
    <h1 class="text-4xl font-dynapuff font-bold mb-4">VIDEO 1</h1>
    <p class="text-2xl font-dynapuff mb-4">Descubre como se elaboro el SISTEMA DE GESTIÓN DE VENTAS PARA SUPERTICKET utilizando herramientas de análisis y diseño de sistemas.</p>
    <section class="max-w-5xl mx-auto px-4 py-10">
      <div class="mb-6">
        <h2 class="text-2xl font-medium">Videos tutoriales</h2>
        <p class="text-sm text-gray-500 mt-1">Material de apoyo del sistema SuperTicket Bolivia</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          {
            id: "uYuTTSb0JI4",
            title: "Tutorial SuperTicket",
            desc: "Introducción y demostración del sistema de venta de entradas.",
            num: 1
          },
          {
            id: "FHs9qXkx68k",
            title: "Tutorial SuperTicket",
            desc: "Gestión y control de accesos para eventos masivos.",
            num: 2
          }
        ].map(v => (
          <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <div class="relative w-full" style="padding-top: 56.25%;">
              <iframe
                class="absolute top-0 left-0 w-full h-full"
                src={`https://www.youtube.com/embed/${v.id}`}
                allowfullscreen
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              />
            </div>
            <div class="p-4">
              <span class="inline-flex items-center gap-1 bg-blue-50 text-blue-800 text-xs px-3 py-1 rounded-full mb-2">
                Video {v.num}
              </span>
              <p class="font-medium text-sm">{v.title}</p>
              <p class="text-xs text-gray-500 mt-1">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</section>

<FOOTER />


