---

<header class="bg-[#1e538a] lg:h-27 md:15 sm:15"> 
  <NAV /> 
</header>
<div class="w-full flex items-center justify-center">
  
  <!-- recuadro de puntos -->
  
  <section class="bg-gray-800 w-100 h-110 flex flex-col p-6 rounded-2xl">
    <h3 class="text-2xl text-white m-3 font-[dynapuff] text-center border-b-2 mb-6">Marco Teorico</h3>
    <ul>
      <li class="text-white m-3">
        <a href="" class="hover:text-cyan-400">
          Introduccion
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#" class="hover:text-cyan-400">
          Antecedentes
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#" class="hover:text-cyan-400">
          Planificacion del Problema
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#" class="hover:text-cyan-400">
          Arbol de Problemas
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#" class="hover:text-cyan-400">
          Formulacion del Problema
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#" class="hover:text-cyan-400">
          Proposito del Estudio
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#" class="hover:text-cyan-400">
          Metodologia
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#" class="hover:text-cyan-400">
