---
import NAV from '../tools/navegationBar.astro'
import "../../assets/fonts.css"

import INTRO from '../marcot/introduction.astro'
import ANTECEDENTES from '../marcot/antecedentes.astro'
import PLANTEAMIENTO from '../marcot/planteamiento.astro'
import ARBOL from '../marcot/arbol.astro'
import FORMULACION from '../marcot/formulacion.astro'
import PROPOSITO from '../marcot/propositoes.astro'
import METODOLOGIA from '../marcot/metodologia.astro'
import ACT from '../marcot/actividad.astro'
import FOOTER from '../tools/footer.astro'
---

<header class="bg-[#1e538a] lg:h-27 md:15 sm:15 mb-5"> 
  <NAV /> 
</header>
<div class="items-start w-full flex items-center justify-center">
  
  <!-- recuadro de puntos -->
  
  <section class="bg-gray-800 w-100 h-fit flex-col p-6 rounded-2xl top-6 sticky hidden lg:flex self-start">
    <h3 class="text-2xl text-white m-3 font-[dynapuff] text-center border-b-2 mb-6">Marco Teorico</h3>
    <ul>
      <li class="text-white m-3">
        <a href="#intro" class="nav-link block text-gray-400 text-sm px-3 py-2 rounded-md border-l-2 border-transparent transition-all duration-200 hover:text-cyan-400">
          Introduccion
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#ant" class="nav-link block text-gray-400 text-sm px-3 py-2 rounded-md border-l-2 border-transparent transition-all duration-200 hover:text-cyan-400">
          Antecedentes
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#plan" class="nav-link block text-gray-400 text-sm px-3 py-2 rounded-md border-l-2 border-transparent transition-all duration-200 hover:text-cyan-400">
          Planificacion del Problema
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#arbol" class="nav-link block text-gray-400 text-sm px-3 py-2 rounded-md border-l-2 border-transparent transition-all duration-200 hover:text-cyan-400">
          Arbol de Problemas
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#form" class="nav-link block text-gray-400 text-sm px-3 py-2 rounded-md border-l-2 border-transparent transition-all duration-200 hover:text-cyan-400">
          Formulacion del Problema
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#prop" class="nav-link block text-gray-400 text-sm px-3 py-2 rounded-md border-l-2 border-transparent transition-all duration-200 hover:text-cyan-400">
          Proposito del Estudio
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#meto" class="nav-link block text-gray-400 text-sm px-3 py-2 rounded-md border-l-2 border-transparent transition-all duration-200 hover:text-cyan-400">
          Metodologia
        </a>
      </li>
      <li class="text-white m-3">
        <a href="#act" class="nav-link block text-gray-400 text-sm px-3 py-2 rounded-md border-l-2 border-transparent transition-all duration-200 hover:text-cyan-400">
          Planificacion de Actividades
        </a>
      </li>
    </ul>
  </section>

  <!-- toda la informacion esta en esta seccion -->

  <section class="w-150 m-7">

    <!-- Introduccion -->
    <div id="intro">
      <INTRO />
    </div>
     
    <!-- Antecedentes -->
    <div id="ant">
      <ANTECEDENTES /> 
    </div>
  
    <!-- Planteamiento del Problema -->
    <div id="plan">
      <PLANTEAMIENTO />
    </div>

    <!-- Arbol de Problema -->
    <div id="arbol">
      <ARBOL />
    </div>

    <!-- Formulacion del Problema -->
    <div id="form">
      <FORMULACION />
    </div>
    
    <!-- Proposito del Estudio -->
    <div id="prop">
      <PROPOSITO />
    </div>

    <!-- Metodologia -->
    <div id="meto">
      <METODOLOGIA />
    </div>
    
    <!-- Planificacion de Actividades -->
    <div id="act">
      <ACT />
    </div>

  </section>
</div>

<FOOTER />

<script>
  const links = document.querySelectorAll('.nav-link');
  const sections = document.querySelectorAll('#intro, #ant, #plan, #arbol, #form, #prop, #meto, #act');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        links.forEach(link => {
          link.classList.remove('text-cyan-400', 'border-cyan-400', 'bg-cyan-400/10');
          link.classList.add('text-gray-400', 'border-transparent');
        });
        const active = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
        if (active) {
          active.classList.remove('text-gray-400', 'border-transparent');
          active.classList.add('text-cyan-400', 'border-cyan-400', 'bg-cyan-400/10');
        }
      }
    });
  }, { threshold: 0.3 });

  sections.forEach(s => observer.observe(s));
</script>
